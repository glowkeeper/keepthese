---
interface Props {
  eyebrow: string;
  title: string;
  note: string;
  members?: { href: string; title: string; author: string }[];
  relatedJourneys?: { href: string; title: string }[];
}
const {
  eyebrow,
  title,
  note,
  members = [],
  relatedJourneys = [],
} = Astro.props;
---

<section class="discovery-context" aria-labelledby="discovery-context-heading">
  <nav aria-label="Breadcrumb">
    <a href="/">Keep These</a><span aria-hidden="true">/</span><span
      aria-current="page">{title}</span
    >
  </nav>
  <p class="eyebrow">{eyebrow}</p>
  <h1 id="discovery-context-heading">{title}</h1>
  <p>{note}</p>
  {
    members.length > 0 && (
      <ol>
        {members.map((member) => (
          <li>
            <a href={member.href}>
              <cite>{member.title}</cite>
              <span>{member.author}</span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
  {
    relatedJourneys.length > 0 && (
      <aside
        class="related-journeys"
        aria-labelledby="related-journeys-heading"
      >
        <h2 id="related-journeys-heading">Continue with a literary path</h2>
        <ul>
          {relatedJourneys.map((journey) => (
            <li>
              <a href={journey.href}>{journey.title}</a>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
</section>
