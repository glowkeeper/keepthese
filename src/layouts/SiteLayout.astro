---
import Wordmark from '../components/Wordmark.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  compactHeader?: boolean;
  eyebrow?: string;
  introduction?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  canonicalPath,
  compactHeader = false,
  eyebrow = 'A blackout poetry studio',
  introduction = 'Find the poem that was waiting in the page.',
  structuredData,
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const socialImageUrl = new URL('/brand/keep-these-og.png', Astro.site);
const isHomepage = canonicalPath === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e8e0d1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" href="/brand/keep-these-square.png" sizes="512x512" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Keep These" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Keep These — find a poem hiding in a page"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta
      name="twitter:image:alt"
      content="Keep These — find a poem hiding in a page"
    />
    {
      structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData).replace(/</gu, '\\u003c')}
        />
      )
    }
    <title>{title}</title>
  </head>
  <body>
    <main>
      <header
        class:list={['site-header', { 'site-header--compact': compactHeader }]}
      >
        <p class="eyebrow">{eyebrow}</p>
        {
          isHomepage ? (
            <h1 class="brand-heading">
              <a class="wordmark-route" href="/">
                <Wordmark />
              </a>
            </h1>
          ) : (
            <div class="brand-heading">
              <a class="wordmark-route" href="/">
                <Wordmark />
              </a>
            </div>
          )
        }
        <p class="introduction">{introduction}</p>
      </header>
      <slot />
      <footer class="site-footer">
        <nav aria-label="Footer">
          <a href="/blackout-poetry/">How-to</a>
          <a href="/about/">About</a>
          <a href="/privacy/">Privacy</a>
        </nav>
        <p><small>© 2026 Keep These</small></p>
      </footer>
    </main>
  </body>
</html>
