---
import Wordmark from '../components/Wordmark.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, canonicalPath, structuredData } = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const socialImageUrl = new URL('/brand/keep-these-og.png', Astro.site);
const isHomepage = canonicalPath === '/';
const siteUrl = new URL('/', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e8e0d1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/brand/keep-these-square.png" sizes="512x512" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Keep These" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Keep These — find a poem hiding in a page"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta
      name="twitter:image:alt"
      content="Keep These — find a poem hiding in a page"
    />
    {
      structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData).replace(/</gu, '\\u003c')}
        />
      )
    }
    <title>{title}</title>
  </head>
  <body>
    <main>
      <header class="site-header">
        <p class="eyebrow">A blackout poetry studio</p>
        {
          isHomepage ? (
            <h1 class="brand-heading">
              <a class="wordmark-route" href="/">
                <Wordmark />
              </a>
            </h1>
          ) : (
            <div class="brand-heading">
              <a class="wordmark-route" href="/">
                <Wordmark />
              </a>
            </div>
          )
        }
        <p class="introduction">Find the poem waiting on the page.</p>
        <nav class="site-navigation" aria-label="Primary">
          <a href="/explore/">Explore</a>
          <a href="/blackout-poetry/">How-to</a>
          <a href="/about/">About</a>
          <button
            class="share-button share-button--icon"
            type="button"
            data-share-site
            data-share-url={siteUrl}
            aria-label="Share Keep These"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <circle cx="18" cy="5" r="2.5"></circle>
              <circle cx="6" cy="12" r="2.5"></circle>
              <circle cx="18" cy="19" r="2.5"></circle>
              <path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5"></path>
            </svg>
          </button>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <nav aria-label="Footer">
          <a href="/privacy/">Privacy</a>
          <button
            class="share-button"
            type="button"
            data-share-site
            data-share-url={siteUrl}
          >
            Share Keep These
          </button>
          <button class="share-button" type="button" data-install-button hidden>
            Install Keep These
          </button>
          <button class="share-button" type="button" data-update-button hidden>
            Update now
          </button>
          <span
            class="visually-hidden"
            data-share-feedback
            aria-live="polite"
            aria-atomic="true"></span>
          <span
            class="visually-hidden"
            data-offline-feedback
            aria-live="polite"
            aria-atomic="true"></span>
        </nav>
        <p class="offline-status" data-offline-status hidden></p>
        <p>
          <small>© 2026 <a href="https://huckle.studio">Steve Huckle</a></small>
        </p>
      </footer>
    </main>
    <script>
      import {
        browserOfflineServices,
        connectOfflineSupport,
      } from '../lib/offline-install';
      import { connectShareControls } from '../lib/site-share';

      connectShareControls();
      // The worker only exists in the production build, where it is generated
      // from the finished site; in development it would cache stale files.
      if (import.meta.env.PROD) {
        void connectOfflineSupport(document, browserOfflineServices());
      }
    </script>
  </body>
</html>
