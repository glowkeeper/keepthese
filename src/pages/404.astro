---
import Wordmark from '../components/Wordmark.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#e8e0d1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Page not found — Keep These</title>
  </head>
  <body>
    <main class="error-page">
      <div class="error-wordmark"><Wordmark /></div>
      <h1>This page fell away.</h1>
      <p>
        There is nothing to keep here, but the studio and its waiting pages are
        still where you left them.
      </p>
      <a href="/">Return to Keep These</a>
    </main>
  </body>
</html>
