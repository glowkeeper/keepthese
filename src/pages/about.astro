---
import SiteLayout from '../layouts/SiteLayout.astro';

const description =
  'About Keep These, a calm and private instrument for making blackout poetry from classic writing.';
---

<SiteLayout
  canonicalPath="/about/"
  description={description}
  eyebrow="The project and its principles"
  introduction="An instrument for finding poems in existing writing."
  title="About Keep These"
>
  <article class="practice-guide">
    <h1>About Keep These</h1>
    <p>
      Keep These is a <a href="/blackout-poetry/">blackout-poetry app</a> that never
      chooses words or composes a poem for you. It offers a carefully chosen shelf
      of classic writing and lets you keep the words that speak while the rest falls
      away.
    </p>
    <p>
      The technology prepares the page, keeps your choices in their original
      order, and helps you save a finished image. Every literary page names its
      source and offers a route back to the original work.
    </p>
    <p>
      Keep These is designed for attention rather than engagement: no feed, no
      scores, no account prompt, and no pressure to publish.
    </p>
    <p><a href="/">Return to the studio</a></p>
  </article>
</SiteLayout>
