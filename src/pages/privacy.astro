---
import SiteLayout from '../layouts/SiteLayout.astro';

const description =
  'How Keep These protects private poem-making without accounts, analytics, cookies, or poem uploads.';
---

<SiteLayout
  canonicalPath="/privacy/"
  description={description}
  eyebrow="How your work stays private"
  introduction="Your unfinished work stays with you."
  title="Privacy — Keep These"
>
  <article class="practice-guide">
    <h1>Privacy</h1>
    <p>
      Your unfinished work is saved only in this browser. Keep These has no
      accounts, analytics, advertising trackers, or poem uploads.
    </p>
    <p>
      PNGs are made on your device. If you copy a poem link, its compact poem
      data sits after the <code>#</code> in the address. That fragment is used by
      your browser and is not sent to the Keep These server when the page is requested.
    </p>
    <p>
      Following a source-edition link takes you to the named external archive or
      catalogue, whose own privacy practices then apply. You can remove
      unfinished work at any time with the discard control in the studio.
    </p>
    <p><a href="/">Return to the studio</a></p>
  </article>
</SiteLayout>
