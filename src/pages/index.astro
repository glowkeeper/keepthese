---
import { getCollection } from 'astro:content';

import BlackoutStudio from '../components/BlackoutStudio';
import '../styles/global.css';

const title = 'Keep These';
const description =
  'A quiet instrument for finding poems within existing writing.';
const passages = await getCollection('passages');
const passage = passages[0];

if (!passage) {
  throw new Error('The playable sketch requires one verified passage.');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <header class="site-header">
        <p class="eyebrow">A quiet blackout poetry studio</p>
        <h1>{title}</h1>
        <p class="introduction">{description}</p>
      </header>

      <BlackoutStudio passage={passage.data} client:load />
    </main>
  </body>
</html>
