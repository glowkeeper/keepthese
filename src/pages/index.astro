---
import { getCollection } from 'astro:content';

import PassageDiscovery from '../components/PassageDiscovery';
import '../styles/global.css';

const title = 'Keep These';
const description =
  'A quiet instrument for finding poems within existing writing.';
const passageOrder = [
  'frankenstein-1831-chapter-4-life-and-death',
  'persuasion-1818-chapter-4-prudence-and-romance',
  'jane-eyre-1847-chapter-10-wide-world',
  'middlemarch-1871-book-2-other-side-of-silence',
  'douglass-1845-chapter-6-pathway-to-freedom',
  'moby-dick-1851-chapter-1-watery-world',
  'dorian-gray-1891-preface-art-and-beauty',
  'alice-1865-chapter-1-daisy-chain',
  'great-expectations-1861-chapter-9-memorable-day',
  'yellow-wallpaper-1892-light-and-pattern',
];
const collection = await getCollection('passages');
const byId = new Map(collection.map(({ data }) => [data.passageId, data]));
const passages = passageOrder.map((passageId) => {
  const passage = byId.get(passageId);
  if (!passage) {
    throw new Error(`The passage shelf is missing ${passageId}.`);
  }
  return passage;
});

if (collection.length !== passageOrder.length) {
  throw new Error('The passage shelf and verified collection are out of sync.');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <header class="site-header">
        <p class="eyebrow">A quiet blackout poetry studio</p>
        <h1>{title}</h1>
        <p class="introduction">{description}</p>
      </header>

      <PassageDiscovery passages={passages} client:load />
    </main>
  </body>
</html>
