---
import PassageDiscovery from '../components/PassageDiscovery';
import SiteLayout from '../layouts/SiteLayout.astro';
import { loadSiteContent } from '../lib/site-content';

const { journeys, passages } = await loadSiteContent();
---

<SiteLayout
  canonicalPath="/"
  description="Make blackout poetry from a carefully chosen shelf of classic writing."
  title="Keep These — a quiet blackout poetry studio"
>
  <PassageDiscovery journeys={journeys} passages={passages} client:load />
</SiteLayout>
