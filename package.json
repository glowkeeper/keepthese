{
  "name": "keepthese",
  "private": true,
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSING.md",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run typecheck && astro build && node scripts/verify-search-output.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings 0",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "verify:search:production": "npm run build && node scripts/verify-production-search.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run lint:markdown && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "astro": "^7.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
